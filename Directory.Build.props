<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
    <!-- Enable Microsoft.Testing.Platform runner globally for test projects -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- Dependabot's updater container also sets GITHUB_ACTIONS=true. Locked mode there makes its restore fail with NU1004 after it bumps Directory.Packages.props, so it skips every packages.lock.json. -->
    <RestoreLockedMode Condition="'$(DEPENDABOT_JOB_ID)' == ''">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- TEMP diagnostic: dump GitHub env seen by restore. -->
  <Target Name="DumpGitHubEnv" BeforeTargets="Restore">
    <Message Importance="high" Text="DIAG GITHUB_WORKFLOW=[$(GITHUB_WORKFLOW)] GITHUB_WORKFLOW_REF=[$(GITHUB_WORKFLOW_REF)] GITHUB_JOB=[$(GITHUB_JOB)] GITHUB_EVENT_NAME=[$(GITHUB_EVENT_NAME)] NuGetAudit=[$(NuGetAudit)]" />
  </Target>
</Project>
